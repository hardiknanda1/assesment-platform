# ─── Database (PostgreSQL / Neon) ─────────────────────────────────────────
# Runtime connection. On Neon/Vercel use the *pooled* connection string
# (host contains "-pooler") so serverless functions share connections.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/assessment"
# Direct (non-pooled) connection used by Prisma migrations and seeding.
# Locally this can be the same as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/assessment"
# Max connections per server instance (keep small on serverless).
DATABASE_POOL_MAX=5

# ─── Clerk (https://dashboard.clerk.com → API keys) ───────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/register

# ─── Authorization ────────────────────────────────────────────────────────
# Comma-separated emails promoted to ADMIN on their first sign-in
# (email must be verified in Clerk). Roles can also be set with:
#   npm run user:role -- someone@example.com ADMIN
ADMIN_EMAILS=""

# ─── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="EduAssess"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"
# IANA timezone used for displaying dates and daily stats.
NEXT_PUBLIC_APP_TIMEZONE="Asia/Kolkata"
